<?xml version="1.0" encoding="UTF-8"?>
<!--
    Opt-in coverage configuration.

    The default phpunit.xml no longer enables code coverage because CI/dev
    environments may not have a coverage driver (Xdebug or PCOV) installed,
    which makes `./vendor/bin/phpunit` fail with "No code coverage driver
    available" instead of running the suite.

    To collect coverage locally (with a coverage driver installed), run:
        composer coverage
        (or: ./vendor/bin/phpunit -c phpunit-coverage.xml.dist)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnEmptyTestSuite="true"
>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory>src</directory>
        </include>
        <report>
            <html outputDirectory="build/coverage"/>
            <text outputFile="build/coverage.txt" showOnlySummary="true"/>
        </report>
    </coverage>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>

</phpunit>
